+// Bounded waiting for TWIM events: returns false if neither evt nor error
+// becomes set within TWIM_TIMEOUT_MS. Prevents permanent busy-loop when an
+// external device holds SDA/SCL low (endless clock stretch / short).
+static const uint32_t TWIM_TIMEOUT_MS = 50;
+
+static bool twimWait(volatile uint32_t* evt, volatile uint32_t* err)
+{
+  uint32_t t0 = millis();
+  while (!(*evt) && !(*err))
+  {
+    if ((millis() - t0) > TWIM_TIMEOUT_MS) return false;
+  }
+  return true;
+}
+
+static void twimAbort(NRF_TWIM_Type* twi)
+{
+  twi->TASKS_STOP = 0x1UL;
+  uint32_t t0 = millis();
+  while (!twi->EVENTS_STOPPED && ((millis() - t0) <= TWIM_TIMEOUT_MS)) {}
+  twi->EVENTS_STOPPED = 0x0UL;
+  twi->EVENTS_ERROR  = 0x0UL;
+  twi->ERRORSRC = 0xFFFFFFFFUL; // write-to-clear
+}
